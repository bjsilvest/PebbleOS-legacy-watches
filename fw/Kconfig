rsource "apps/Kconfig"
rsource "kernel/Kconfig"
rsource "services/Kconfig"

menu "Software Features"

config SETTINGS_ICONS
    bool "Settings menu icons"
    help
      Show icons next to entries in the system Settings menu.

config THEMING
    bool "Color theming"
    help
      Expose the highlight-color theming UI under Settings.

config BACKLIGHT_STANDARD_INTENSITY
    int "Standard backlight preset intensity (%)"
    range 1 100
    default 50
    help
      Logical brightness used by the Standard backlight preset and fresh
      shell preferences. The light service scales it to the board hardware
      maximum. Saved brightness preferences take precedence.

config DYNAMIC_BACKLIGHT
    bool "Dynamic backlight"
    help
      Adjust backlight intensity based on ambient light readings.
      Requires an ambient light sensor.

config ACCEL_SENSITIVITY
    bool "Accelerometer sensitivity setting"
    help
      Expose the accelerometer tap/shake sensitivity adjustment in
      Settings.

config APP_SCALING
    bool "App scaling"
    help
      Scale legacy lower-resolution apps to the current display via
      the compositor.

config ORIENTATION_MANAGER
    bool "Orientation manager UI"
    help
      Expose the device-orientation / rotation prefs in shell and
      Settings. Independent of CONFIG_SERVICE_ORIENTATION_MANAGER,
      which controls whether the underlying service is built.

config MODDABLE_XS
    bool "Moddable XS JavaScript engine"
    depends on USERSPACE
    help
      Build Moddable XS support for running JavaScript apps. PRF
      variant builds force this off regardless of the board default.

config MMAP_RESOURCES
    bool "Memory-mapped (zero-copy) resource reads"
    help
      Serve read-only system resources as direct pointers into
      memory-mapped flash instead of copying them out.

config FIRMWARE_LEGACY_CRC
    bool "Firmware descriptions use the legacy STM32 CRC"
    depends on !PBLBOOT
    help
      The checksum in a firmware image's description (in flash, ahead of
      the image) is the legacy STM32 CRC, not CRC32, as the stock
      bootloader and recovery firmware of older watches (snowy) expect.
      Used to check the recovery image and to write staged updates.

config FIRMWARE_NEW_WORLD_MARKER
    bool "Mark the vector table for the original Pebble's bootloader"
    depends on !PBLBOOT
    help
      Put "NeWo" (0x4E65576F) in the reserved vector table word at offset
      28. The stock tintin bootloader only boots, and only installs, an
      image at 0x08004000 when it finds the marker there.

endmenu

choice
    prompt "Shell"
    default SHELL_NORMAL

config SHELL_NORMAL
    bool "Normal shell"

config SHELL_SDK
    bool "SDK shell"
    help
      Use the SDK shell instead of the normal shell.

endchoice

menu "Debug & instrumentation"

config QEMU_SERIAL
    bool "QEMU serial protocol"
    default y if QEMU
    help
      The Pebble protocol and the emulator's controls (battery, taps,
      time format, ...) over the board's QEMU_UART, framed as libpebble2's
      QEMU transport expects.

config NO_WATCH_TIMEOUT
    bool "Disable watchface idle timeout"

config UI_DEBUG
    bool "UI debug commands"
    help
      Enable the window dump and layer nudge CLI commands.

config MALLOC_INSTRUMENTATION
    bool "Malloc instrumentation"
    help
      Track the caller PC of every heap allocation.

config ADVANCED_LOGGING_BUFFER_SIZE
    int "Flash log buffer size"
    default 1200
    help
      RAM that collects log lines until they are written to flash. Hashed
      lines are 30-80 bytes, so 1200 holds 15-40 of them.

config PROFILER
    bool "Profiler"

config PERFORMANCE_TESTS
    bool "Performance test instrumentation"
    select PROFILER

endmenu
