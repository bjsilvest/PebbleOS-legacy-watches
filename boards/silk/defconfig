# silk (Pebble 2) board configuration

CONFIG_SOC_STM32F4=y

CONFIG_HAL_STM32_STM32F412=y

CONFIG_PLATFORM_FLINT=y

CONFIG_SCREEN_COLOR_DEPTH_BITS_1=y

CONFIG_FLASH=y
CONFIG_FLASH_MX25U=y
CONFIG_FLASH_LAYOUT_SILK=y

CONFIG_GPIO=y
CONFIG_RNG=y

CONFIG_OTP=y

CONFIG_RTC=y

CONFIG_UART=y

CONFIG_EXTI=y

CONFIG_DISPLAY=y

# Temporary fixed-value stand-ins until the silk drivers exist:
# AS3701B battery, vibe PWM, backlight PWM, BMA255, ALS ADC, DFSDM mic.
CONFIG_BATTERY=y
CONFIG_BATTERY_POSIX=y
CONFIG_VIBE=y
CONFIG_VIBE_POSIX=y
CONFIG_BACKLIGHT=y
CONFIG_BACKLIGHT_POSIX=y
CONFIG_ACCEL_POSIX=y
CONFIG_AMBIENT_LIGHT=y
CONFIG_AMBIENT_LIGHT_QEMU=y
CONFIG_TEMPERATURE=y
CONFIG_TEMPERATURE_QEMU=y
CONFIG_MIC=y
CONFIG_MIC_QEMU=y

CONFIG_WATCHDOG=y
