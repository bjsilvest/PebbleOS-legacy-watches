# silk (Pebble 2) board configuration

CONFIG_SOC_STM32F4=y

CONFIG_HAL_STM32_STM32F412=y

CONFIG_PLATFORM_FLINT=y

CONFIG_SCREEN_COLOR_DEPTH_BITS_1=y

CONFIG_FLASH=y
CONFIG_FLASH_MX25U=y
CONFIG_FLASH_LAYOUT_SILK=y

CONFIG_GPIO=y
CONFIG_RNG=y

CONFIG_OTP=y

CONFIG_RTC=y

CONFIG_UART=y

CONFIG_EXTI=y

CONFIG_DISPLAY=y

CONFIG_TEMPERATURE=y

CONFIG_MIC=y
CONFIG_MIC_STM32_DFSDM=y

CONFIG_WATCHDOG=y

CONFIG_I2C=y

CONFIG_PMIC=y
CONFIG_PMIC_AS3701B=y

CONFIG_BATTERY=y

CONFIG_PWM=y

CONFIG_VIBE=y
CONFIG_VIBE_PWM=y

CONFIG_REGULATOR_GPIO=y

CONFIG_BACKLIGHT=y
CONFIG_BACKLIGHT_PWM=y

CONFIG_ACCEL=y
CONFIG_ACCEL_BMA255=y

CONFIG_AMBIENT_LIGHT=y
CONFIG_AMBIENT_LIGHT_STM32_ADC=y
CONFIG_AMBIENT_LIGHT_THRESHOLD_LOCAL=y
# Backlight brightness follows the light sensor (Settings > Display), with the
# sensor's calibration table in board_silk.c.
CONFIG_AMBIENT_LIGHT_LUX_TABLE=y
CONFIG_DYNAMIC_BACKLIGHT=y

CONFIG_HRM=y
CONFIG_HRM_AS7000=y
# HRV while an app asks (Pebble 2 apps need an updated SDK to ask)
CONFIG_HRM_AS7000_HRV=y

# Settings: motion sensitivity and left-handed (rotated) wear
CONFIG_ACCEL_SENSITIVITY=y
CONFIG_ORIENTATION_MANAGER=y

# GAP Peripheral Preferred Connection Parameters, as the stock firmware has:
# Service Changed then sits at the stock handle, which phones that cached the
# stock layout honor. Values match our low-power connection parameters.
CONFIG_NIMBLE_BLE_SVC_GAP_PPCP_MIN_CONN_INTERVAL=24
CONFIG_NIMBLE_BLE_SVC_GAP_PPCP_MAX_CONN_INTERVAL=36
CONFIG_NIMBLE_BLE_SVC_GAP_PPCP_SLAVE_LATENCY=30
CONFIG_NIMBLE_BLE_SVC_GAP_PPCP_SUPERVISION_TMO=600

# No Bluetooth bring-up rows under Information: the port is tested.
CONFIG_BT_CONTROLLER_DIAGNOSTICS=n
