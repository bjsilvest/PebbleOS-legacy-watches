# 1 MiB of flash less the 16 KiB stock bootloader the image is linked past.
config FW_FLASH_SIZE
    default 0xfc000

config QEMU_MACHINE
    default "pebble-silk-bb"

config RESOURCES_BOARD
    default "qemu_silk"

# The DA14681 controller only has the SDK's placeholder public address.
choice BT_ID_ADDR_SOURCE
    default BT_ID_ADDR_STORAGE
endchoice
