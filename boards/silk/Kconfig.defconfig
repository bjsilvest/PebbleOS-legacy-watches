# 1 MiB of flash less the 16 KiB stock bootloader the image is linked past.
config FW_FLASH_SIZE
    default 0xfc000

config QEMU_MACHINE
    default "pebble-silk-bb"

config RESOURCES_BOARD
    default "qemu_silk"

# The DA14681 controller only has the SDK's placeholder public address. Derive
# a random static one from the serial number like the legacy firmware.
choice BT_ID_ADDR_SOURCE
    default BT_ID_ADDR_SERIAL
endchoice

# The recovery firmware is the stock one, with its own shared PRF storage and
# pinned address. Import both so phones see one watch in either firmware.
config SERVICE_SHARED_PRF_STORAGE_IMPORT_STOCK
    default y

config SERVICE_BLUETOOTH_ALWAYS_PIN_ADDRESS
    default y

# The DA14681 completes each 27-byte ACL fragment with its own event, and the
# HCI thread blocks when the pool runs out, so give it room.
config NIMBLE_BLE_TRANSPORT_EVT_COUNT
    default 16 if BT_CONTROLLER_DA1468X

# Show the same 1% charge percent as the phone app.
config BATTERY_EXACT_PERCENT
    default y

# Must match the controller image's DGTL UART (tools/silk_bt).
config BT_DA1468X_HCI_BAUD
    default 1000000
