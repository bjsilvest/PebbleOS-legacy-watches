# tintin (original Pebble) board configuration

CONFIG_SOC_STM32F4=y

CONFIG_SOC_STM32F205=y

CONFIG_PLATFORM_APLITE=y

CONFIG_SCREEN_COLOR_DEPTH_BITS_1=y

# 496 KiB for the whole firmware
CONFIG_LTO=y

CONFIG_FLASH=y
CONFIG_FLASH_N25Q=y
CONFIG_FLASH_LAYOUT_TINTIN=y

CONFIG_GPIO=y
CONFIG_RNG=y

CONFIG_OTP=y

CONFIG_RTC=y

CONFIG_UART=y

CONFIG_EXTI=y

CONFIG_DISPLAY=y

CONFIG_TEMPERATURE=y

CONFIG_WATCHDOG=y

CONFIG_BATTERY=y
CONFIG_BATTERY_GPIO_ADC=y

CONFIG_PWM=y

CONFIG_VIBE=y
CONFIG_VIBE_GPIO=y

CONFIG_BACKLIGHT=y
CONFIG_BACKLIGHT_PWM=y

CONFIG_AMBIENT_LIGHT=y
CONFIG_AMBIENT_LIGHT_STM32_ADC=y

# What the original Pebble never had, or has no room for: Health, weather,
# app glances, timeline Quick View, analytics heartbeats, the debug shell.
CONFIG_SERVICE_ACTIVITY=n
CONFIG_SERVICE_WEATHER=n
CONFIG_SERVICE_APP_GLANCES=n
CONFIG_TIMELINE_PEEK=n
CONFIG_SERVICE_ANALYTICS_NATIVE=n
CONFIG_SHELL=n
CONFIG_PULSE_EVERYWHERE=n

# TI CC2564A on USART1. Its 24 KB init script stays unmodified in the
# system resources (third_party/ti_bt_sp/bluetooth_init_cc2564_2.14.bts).
CONFIG_BT_HCI_UART=y
CONFIG_BT_CONTROLLER_CC2564=y
CONFIG_BT_CC2564_BTS_RESOURCE=y
CONFIG_NIMBLE_BLE_TRANSPORT_ISO_COUNT=0

# Peripheral only, legacy pairing (the CC2564A is Bluetooth 4.0).
CONFIG_NIMBLE_BLE_ROLE_CENTRAL=n
CONFIG_NIMBLE_BLE_ROLE_OBSERVER=n
CONFIG_NIMBLE_BLE_GATT_SIGNED_WRITE=n
CONFIG_NIMBLE_BLE_GATT_WRITE_RELIABLE=n
CONFIG_NIMBLE_BLE_GATT_READ_MULT=n
CONFIG_NIMBLE_BLE_GATT_FIND_INC_SVCS=n
CONFIG_NIMBLE_BLE_SM_SC=n
CONFIG_NIMBLE_BLE_SM_SC_ONLY=n
CONFIG_NIMBLE_BLE_SM_LEGACY=y
CONFIG_NIMBLE_BLE_SM_MITM=n
CONFIG_NIMBLE_BLE_SM_LVL=0

CONFIG_I2C=y
CONFIG_REGULATOR_GPIO=y

CONFIG_ACCEL_LIS3DH=y

CONFIG_MAG=y
CONFIG_MAG_MAG3110=y

# The 256 KiB stock resource bank has no room for Gothic 36 and LECO 60;
# the tintin resource map aliases them to Gothic 28 and LECO 42.
CONFIG_RESOURCES_LARGE_FONTS=n
# Same glyphs in less space.
CONFIG_RESOURCES_COMPACT_FONTS=y

# 24 task timers are in use once booted (192 on the bigger watches); give
# the 3.8 KB back to the kernel heap.
CONFIG_TASK_TIMER_POOL_SIZE=96
