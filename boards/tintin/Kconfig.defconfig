# 512 KiB of flash less the 16 KiB stock bootloader the image is linked past.
config FW_FLASH_SIZE
    default 0x7c000

config QEMU_MACHINE
    default "pebble-bb2"

# The stock bootloader checks staged firmware, and the stock PRF image was
# written, with the legacy STM32 CRC.
config FIRMWARE_LEGACY_CRC
    default y

config FIRMWARE_NEW_WORLD_MARKER
    default y

# Show the same 1% charge percent as the phone app.
config BATTERY_EXACT_PERCENT
    default y

# Apps and the worker sit at the end of RAM, so the 25952 + 6820 aplite app
# region would start 4 bytes off the 32-byte alignment the MPU needs. Nothing
# reads the runtime part separately; 6816 makes the region exactly 32 KiB.
config APP_RAM_APLITE_RUNTIME_SIZE
    default 6816

# Like the stock firmware, use the CC2564's factory (public, TI) address, so
# the watch keeps its stock name and address. Fall back to one derived from
# the serial number if the chip reports none.
choice BT_ID_ADDR_SOURCE
    default BT_ID_ADDR_SERIAL
endchoice

config BT_ID_ADDR_PREFER_PUBLIC
    default y

# As on snowy: four event buffers run out under notification traffic.
config NIMBLE_BLE_TRANSPORT_EVT_COUNT
    default 16

# As on snowy, where the same driver sleeps on hardware: the chip deep
# sleeps (eHCILL) and the host enters STOP meanwhile.
config BT_CC2564_SLEEP
    default y
