if SOC_STM32F4

# 1 MiB of internal flash (F205: 512 KiB); the stock bootloader occupies the
# first 16 KiB.
config FLASH_BASE
    default 0x08000000

config FLASH_SIZE
    default 0x80000 if SOC_STM32F205
    default 0x100000

config FLASH_OFFSET
    default 0x4000

# F412: 256 KiB of SRAM. F439: 192 KiB of SRAM and 64 KiB of CCM. F205: 128 KiB.
config SRAM_BASE
    default 0x20000000

config SRAM_SIZE
    default 0x20000 if SOC_STM32F205
    default 0x30000 if HAL_STM32_STM32F439
    default 0x40000

config CCM_BASE
    default 0x10000000 if HAL_STM32_STM32F439

config CCM_SIZE
    default 0x10000 if HAL_STM32_STM32F439

config NUM_IRQS
    default 81 if SOC_STM32F205
    default 91 if HAL_STM32_STM32F439
    default 97

config NUM_IRQ_PRIO_BITS
    default 4

endif # SOC_STM32F4
