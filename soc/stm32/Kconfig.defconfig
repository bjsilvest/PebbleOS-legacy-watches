if SOC_STM32F4

# 1 MiB of internal flash; the stock bootloader occupies the first 16 KiB.
config FLASH_BASE
    default 0x08000000

config FLASH_SIZE
    default 0x100000

config FLASH_OFFSET
    default 0x4000

# 256 KiB of SRAM.
config SRAM_BASE
    default 0x20000000

config SRAM_SIZE
    default 0x40000

config NUM_IRQS
    default 97

config NUM_IRQ_PRIO_BITS
    default 4

endif # SOC_STM32F4
