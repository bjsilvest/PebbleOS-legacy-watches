config BT_CONTROLLER_DA1468X
    bool "DA1468x controller booted from RAM"
    depends on SOC_STM32F4 && BT_HCI_UART
    help
      Boot a Dialog DA1468x as the H4 HCI controller. Its bootrom loads a
      small stage 2 over UART, which then receives the controller image at
      1 Mbaud. Both images run from the radio's RAM; nothing is written to
      its non-volatile memory.

      The images are built outside this tree from the Dialog SDK, which may
      not be redistributed, and embedded from the paths below. See
      docs/boards/silk.

if BT_CONTROLLER_DA1468X

config BT_DA1468X_STAGE2_IMAGE
    string "Stage 2 image"
    help
      Absolute path to the stage 2 loader binary.

config BT_DA1468X_CONTROLLER_IMAGE
    string "Controller image"
    help
      Absolute path to the HCI controller binary.

config BT_DA1468X_HCI_BAUD
    int "HCI baud rate"
    default 115200
    help
      Baud rate of the controller image's H4 UART.

endif

config BT_CONTROLLER_CC2564
    bool "TI CC2564 controller"
    depends on SOC_STM32F4 && BT_HCI_UART
    help
      Power up a TI CC2564 as the H4 HCI controller and load TI's
      initialization script (third_party/ti_bt_sp), which it needs at every
      power up. The board provides BOARD_BT_SHUTDOWN, BOARD_BT_CTS and
      BOARD_MCO1 for its 32 kHz slow clock.

config BT_CC2564_BTS_RESOURCE
    bool "Init script from the system resources"
    depends on BT_CONTROLLER_CC2564
    help
      Read TI's initialization script from the BT_INIT_SCRIPT system
      resource, which the board's resource map provides, instead of
      building TIInit_6.7.16.bts into the firmware. For boards with little
      internal flash and another script (the CC2564A's is 24 KB).

config BT_CC2564_HCI_BAUD
    int "HCI baud rate"
    depends on BT_CONTROLLER_CC2564
    default 921600
    help
      Baud rate the controller is switched to after power up.

config BT_CC2564_SLEEP
    bool "CC2564 deep sleep (eHCILL)"
    depends on BT_CONTROLLER_CC2564
    help
      Let the controller deep sleep with TI's eHCILL protocol (SWRA288)
      and the host enter STOP mode meanwhile. Without it the controller
      never sleeps and STOP is blocked while Bluetooth runs.

config BT_CONTROLLER_DIAGNOSTICS
    bool "Controller bring-up diagnostics"
    depends on BT_CONTROLLER_DA1468X || BT_CONTROLLER_CC2564
    default y
    help
      Keep pairing, SMP, app fetch and controller start-up traces and show
      them in Settings > System > Information, along with the last reboot
      reason. For bringing up a port; not something to ship upstream.

config BT_CC2564_SLEEP_NO_STOP
    bool "Keep the host out of STOP while the controller sleeps"
    depends on BT_CC2564_SLEEP
    help
      The controller still deep sleeps, but STOP stays blocked while
      Bluetooth runs, in case STOP stops MCO1, the controller's slow clock.
      For testing the two apart.

config BT_HCI_UART_STACK_SIZE
    int "HCI UART thread stack size in bytes"
    default 2048 if BT_CONTROLLER_DA1468X || BT_CONTROLLER_CC2564
    default 1024
    help
      Booting the DA1468X or CC2564 controller also runs on this thread,
      so those need the larger stack.
