menuconfig AMBIENT_LIGHT
    bool "Ambient Light Sensor"
    help
      Ambient light sensor drivers (pbl/drivers/als.h). The board
      instantiates the sensor it has and exports it as ALS.

if AMBIENT_LIGHT

config AMBIENT_LIGHT_OPT3001
    bool "TI OPT3001"
    depends on I2C
    help
      Support for the TI OPT3001 ambient light sensor.

config AMBIENT_LIGHT_W1160
    bool "W1160"
    depends on I2C
    help
      Support for the W1160 ambient light sensor.

config AMBIENT_LIGHT_STM32_ADC
    bool "Analog sensor on the STM32 ADC"
    depends on SOC_STM32F4
    help
      Photodiode read through ADC1 against VREFINT, powered by a GPIO
      (silk).

config AMBIENT_LIGHT_THRESHOLD_LOCAL
    bool "Keep the dark threshold off the phone sync"
    help
      Do not sync the backlight's ambient light threshold with the phone,
      and drop a stored one once. For sensors whose scale differs a lot
      from other watches (the original Pebble's reads ~235 in the dark), so
      a value synced from another watch model cannot keep the backlight off.

config AMBIENT_LIGHT_LUX_TABLE
    bool "Convert levels to lux with a board table"
    depends on AMBIENT_LIGHT_STM32_ADC
    help
      Convert raw levels to lux by interpolating between calibration points
      in the sensor's pbl_als_scale table, for a sensor whose response
      is far from linear (a phototransistor that flattens out in bright
      light), instead of the linear offset/num/den conversion.

config AMBIENT_LIGHT_QEMU
    bool "QEMU"
    default y if SOC_QEMU
    help
      QEMU ambient light sensor. QEMU emulates none, so it always reads
      complete darkness.

config AMBIENT_LIGHT_POSIX
    bool "POSIX"
    default y if SOC_POSIX
    help
      Ambient light driver for a native build (always dark).

config AMBIENT_LIGHT_BITS
    int "Ambient light sensor resolution (bits)"
    default 12 if AMBIENT_LIGHT_OPT3001
    default 16 if AMBIENT_LIGHT_W1160
    default 12 if AMBIENT_LIGHT_QEMU
    default 12 if AMBIENT_LIGHT_STM32_ADC
    default 12 if AMBIENT_LIGHT_POSIX
    help
      Number of bits in the ambient light sensor reading. Used to derive
      AMBIENT_LIGHT_LEVEL_MAX, which bounds the dark/backlight thresholds
      exposed to the shell and settings UI.

module = DRIVER_AMBIENT
module-str = Ambient Light Sensor
source "subsys/logging/Kconfig.template.log_level"

endif # AMBIENT_LIGHT
