menuconfig BATTERY
    bool "Battery"
    help
      Battery Drivers

if BATTERY

config BATTERY_PMIC
    bool "PMIC-based"
    help
      Battery management via external PMIC. Used on platforms where the
      PMIC handles battery monitoring (asterix, obelix, getafix).

config BATTERY_GPIO_ADC
    bool "Charger GPIOs and ADC"
    depends on SOC_STM32F4
    help
      Battery without a PMIC: USB power and charging status on GPIOs and
      the battery voltage on the ADC (the original Pebble).

config BATTERY_QEMU
    bool "QEMU Battery"
    default y if SOC_QEMU
    help
      Stub battery driver for QEMU (fixed values).

config BATTERY_POSIX
    bool "POSIX Battery"
    default y if SOC_POSIX
    help
      Battery driver for a native build (fixed values).

endif # BATTERY
