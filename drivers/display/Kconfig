menuconfig DISPLAY
    bool "Display"
    help
      Display Drivers

if DISPLAY

config DISPLAY_SF32LB_LCDC
    bool "SiFli SF32LB LCD controller"
    default y if SOC_SF32LB52
    depends on CLK_SF32LB && PINCTRL && RESET_SF32LB
    select PANEL
    help
      Support for the SiFli SF32LB LCD controller, driving a JDI
      memory-in-pixel panel.

config DISPLAY_SHARP_LS013B7DH01
    bool "Sharp LS013B7DH01"
    default y if SOC_NRF52
    depends on PWM && SPI
    help
      Support for the Sharp LS013B7DH01 memory LCD.

config DISPLAY_SHARP_LS013B7DH01_STM32
    bool "Sharp LS013B7DH01 (STM32)"
    depends on SOC_STM32F4
    default y if HAL_STM32_STM32F412 || SOC_STM32F205
    help
      Support for the Sharp LS013B7DH01 display on an STM32F2/F4 SPI.

config DISPLAY_ICE40LP_STM32
    bool "iCE40LP framebuffer FPGA (STM32)"
    depends on SOC_STM32F4
    default y if HAL_STM32_STM32F439
    help
      Support for the Pebble Time display, driven through an iCE40LP
      framebuffer FPGA on an STM32F4 SPI.

config DISPLAY_QEMU
    bool "QEMU Framebuffer Display"
    default y if SOC_QEMU
    help
      Support for the QEMU framebuffer display peripheral.

config DISPLAY_SDL
    bool "SDL window"
    default y if SOC_POSIX
    select SDL
    help
      Display shown in an SDL window on the host of a native build.

config DISPLAY_SHELL
    bool "Shell commands"
    default y
    depends on SHELL
    help
      The display shell command, to show the display and turn its panel on
      or off.

module = DRIVER_DISPLAY
module-str = Display
source "subsys/logging/Kconfig.template.log_level"

endif # DISPLAY
