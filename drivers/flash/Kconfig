menuconfig FLASH
    bool "Flash"
    help
      Flash Drivers

if FLASH

config FLASH_GD25LQ255E
    bool "GigaDevice GD25LQ255E"
    help
      Support for the GigaDevice GD25LQ255E NOR flash.

config FLASH_GD25Q256E
    bool "GigaDevice GD25Q256E"
    help
      Support for the GigaDevice GD25Q256E NOR flash.

config FLASH_MX25U
    bool "Macronix MX25U (QSPI)"
    depends on SOC_STM32F4
    help
      Support for the Macronix MX25U64 NOR flash on the STM32F412
      QUADSPI, as found on the Pebble 2 (silk).

config FLASH_S29VS
    bool "Spansion S29VS (FMC)"
    depends on HAL_STM32_STM32F439
    help
      Support for the Spansion S29VS parallel NOR flash on the STM32F439
      FMC, as found on the Pebble Time (snowy).

config FLASH_QEMU
    bool "QEMU External Flash"
    default y if SOC_QEMU
    help
      Support for the QEMU external flash peripheral.

config FLASH_POSIX
    bool "POSIX External Flash"
    default y if SOC_POSIX
    help
      External flash backed by a file on the host.

config FLASH_LAYOUT_SILK
    bool "Pebble 2 (silk) stock flash layout"
    select FLASH_GUARD
    help
      Use the stock Pebble 2 external flash layout, keeping the stock
      bootloader's PRF, shared PRF storage and MFG info where they are.

config FLASH_LAYOUT_SNOWY
    bool "Pebble Time (snowy, spalding) stock flash layout"
    select FLASH_GUARD
    help
      Use the stock Pebble Time and Time Round external flash layout, keeping the stock
      bootloader's PRF, shared PRF storage and MFG info (with the boot FPGA
      bitstream) where they are.

config FLASH_GUARD
    bool "Guard regions the firmware does not own"
    help
      Assert instead of issuing any erase or write that overlaps PRF,
      shared PRF storage or MFG info, and refuse security register writes.

module = DRIVER_FLASH
module-str = Flash
source "subsys/logging/Kconfig.template.log_level"

endif # FLASH
