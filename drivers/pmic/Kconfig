menuconfig PMIC
    bool "PMIC"
    help
      PMIC Drivers

if PMIC

config PMIC_NPM1300
    bool "Nordic nPM1300 charger"
    default y
    depends on MFD_NPM1300
    help
      Support for the charger of the Nordic nPM1300 PMIC.

config PMIC_MAX14690
    bool "Maxim MAX14690"
    depends on SOC_STM32F4 && I2C
    help
      Support for the Maxim MAX14690 PMIC on snowy: charger, LDO2 for the
      display FPGA and battery voltage measurement through its MON output.
      Charger settings are the stock firmware's.

config PMIC_AS3701B
    bool "ams AS3701B"
    depends on SOC_STM32F4 && I2C
    help
      Support for the ams AS3701B PMIC on silk: charger, rails, display
      VCOM clock and battery voltage measurement. Charger settings are
      the stock firmware's.

module = DRIVER_PMIC
module-str = PMIC
source "subsys/logging/Kconfig.template.log_level"

endif # PMIC
