menuconfig MIC
    bool "Microphone"
    help
      Microphone Drivers

if MIC

config MIC_NRF5
    bool "Nordic nRF5 PDM"
    default y if SOC_NRF52
    select HAL_NORDIC
    help
      Support for the Nordic nRF5 PDM microphone interface.

config MIC_SF32LB
    bool "SiFli SF32LB PDM"
    default y if SOC_SF32LB52
    select HAL_SIFLI
    select HAL_SIFLI_AUDCODEC
    select HAL_SIFLI_PDM
    select MIC_POLLING
    help
      Support for the SiFli SF32LB PDM microphone interface.

config MIC_STM32_DFSDM
    bool "STM32 DFSDM"
    depends on SOC_STM32F4
    help
      PDM microphone through the STM32F412 DFSDM (silk).

config MIC_STM32_I2S_PDM
    bool "STM32 I2S PDM"
    depends on SOC_STM32F4
    help
      PDM microphone through an STM32F4 SPI in I2S mode, decimated by the
      OpenPDMFilter (snowy).

config MIC_QEMU
    bool "QEMU stub"
    default y if SOC_QEMU || SOC_POSIX
    help
      Software-only microphone for QEMU and native builds. Delivers audio the
      host sends over the QEMU channel (`pebble emu-mic`) at MIC_SAMPLE_RATE,
      and silence when there is none.

config MIC_POLLING
    bool
    help
      The driver implements mic_start_polling(), mic_poll() and
      mic_get_frame_time().

module = DRIVER_MIC
module-str = Microphone
source "subsys/logging/Kconfig.template.log_level"

endif # MIC
