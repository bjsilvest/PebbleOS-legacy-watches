menuconfig RTC
    bool "RTC"
    help
      RTC Drivers

if RTC

config RTC_NRF5
    bool "Nordic nRF5"
    default y if SOC_NRF52
    select HAL_NORDIC
    help
      Support for the Nordic nRF5 RTC.

config RTC_SF32LB
    bool "SiFli SF32LB"
    default y if SOC_SF32LB52
    select HAL_SIFLI
    select HAL_SIFLI_LRC_CAL
    select HAL_SIFLI_RTC
    help
      Support for the SiFli SF32LB RTC.

config RTC_STM32
    bool "ST STM32"
    default y if SOC_STM32F4 && !SOC_STM32F205
    select HAL_STM32
    help
      Support for the STM32F4 RTC.

config RTC_STM32F2
    bool "ST STM32F2"
    default y if SOC_STM32F205
    select HAL_STM32
    help
      Support for the STM32F2 RTC, run in the stock fast mode (the F2 has no
      sub-second register).

config RTC_QEMU
    bool "QEMU RTC"
    default y if SOC_QEMU
    help
      Support for the QEMU RTC peripheral.

config RTC_POSIX
    bool "POSIX RTC"
    default y if SOC_POSIX
    help
      RTC following the host clock.

module = DRIVER_RTC
module-str = RTC
source "subsys/logging/Kconfig.template.log_level"

endif # RTC
